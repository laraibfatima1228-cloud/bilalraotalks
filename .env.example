# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ========================================================
# BILAL RAO LIVE – CONFIGURATION SETTINGS
# ========================================================

# SESSION & SECURITY
# Secret key used to sign administrative JWT session tokens
ADMIN_JWT_SECRET="bilal-rao-live-super-secret-key-change-in-production-2026"

# --------------------------------------------------------
# OPTIONAL EXTERNAL CLOUD SERVICES:
# The application is 100% self-contained with built-in WebRTC
# live streaming and persistent storage out of the box!
# If you wish to use external LiveKit Cloud or Supabase,
# fill in the credentials below:
# --------------------------------------------------------

# LIVEKIT CLOUD STREAMING (Optional - WebRTC works built-in)
# Register at https://cloud.livekit.io/ to get your project credentials
LIVEKIT_URL="wss://bilal-rao-live-xxxxxx.livekit.cloud"
LIVEKIT_API_KEY="APIxxxxxxxxxxxx"
LIVEKIT_API_SECRET="sec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# SUPABASE POSTGRESQL & AUTH (Optional - Built-in database works out-of-the-box)
# Create a project at https://supabase.com
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
